{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "src/lib/epic",
    "outDir": ".test-build"
  },
  "include": ["src/lib/epic/**/*.ts", "src/lib/epic/**/*.json"],
  "exclude": ["src/lib/epic/server/**", "src/lib/epic/client/**"]
}
