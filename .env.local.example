# EPIC247 2.0 — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as de produção na Vercel.
# Nenhum valor real neste arquivo. Gerar segredos:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Ambientes: [L] local · [P] preview/homologação · [PROD] produção
# Detalhes de cada uma: docs/v2/go-live.md, seção 2.

# ── Ambiente ─────────────────────────────────────────────────────────────
# "production" liga indexação, exige assinatura nos webhooks e esconde
# rascunhos. Qualquer outro valor = staging (noindex em tudo).      [L P PROD] obrigatória
NEXT_PUBLIC_EPIC_ENV=staging
# Base dos links nos e-mails.                                          [L P PROD] obrigatória
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Banco (Postgres do Supabase, via pooler em modo transação) ──────────
# Porta 6543. Toda consulta roda em transação com o schema abaixo.     [L P PROD] obrigatória
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres
# Schema do ambiente: v2_staging (local e preview) ou v2 (produção).   [L P PROD] obrigatória
EPIC_DB_SCHEMA=v2_staging

# ── Segredos do site ────────────────────────────────────────────────────
# Assina links (descadastro, acesso ao Plano, pagamento da Mentoria), o hash
# de IP do rate limit e os webhooks de saída. Mínimo 16 caracteres; em
# produção o site falha se faltar. Nunca trocar depois de lançar: invalida
# os links já enviados.                                                 [P PROD] obrigatória
EPIC_SECRET=
# Protege /api/v2/cron/disparar (o mesmo valor vai no pg_cron).          [P PROD] obrigatória
CRON_SECRET=
# Senha do admin (/admin/epic). Sessão de 7 dias; trocar derruba todas.  [L P PROD] obrigatória
ADMIN_PASSWORD=

# ── Pagamento (Kiwify) ──────────────────────────────────────────────────
# Token do webhook cadastrado na Kiwify. Sem ele, produção recusa todo
# webhook e nenhuma compra é confirmada.                                [PROD] obrigatória
KIWIFY_WEBHOOK_TOKEN=

# ── E-mail (Resend) ─────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxx
# Remetente verificado no Resend.                                       [P PROD] obrigatória
EMAIL_FROM=EPIC247 <contato@epic247.com.br>
# simulate = registra sem enviar (staging); live = envia de verdade.   [L P PROD] obrigatória
EPIC_EMAIL_MODE=simulate
# Em simulate, estes endereços recebem de verdade (separados por vírgula). [L P] opcional
EPIC_EMAIL_ALLOWLIST=
# Segredo whsec_ do webhook do Resend (entrega, abertura, clique).      [PROD] obrigatória
RESEND_WEBHOOK_SECRET=
# Avisos internos: contato e interesse na Mentoria.                    [PROD] opcional
EPIC_TEAM_EMAIL=

# ── CRM externo (opcional) ──────────────────────────────────────────────
# Sem URL, nada é enfileirado. Sem segredo próprio, assina com EPIC_SECRET.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ── Supabase (API e Storage: configurações do admin e uploads) ──────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só servidor. Nunca com prefixo NEXT_PUBLIC_.                          [L P PROD] obrigatória
SUPABASE_SERVICE_ROLE_KEY=

# ── Rastreamento ────────────────────────────────────────────────────────
# Pixel, GA4, GTM e Conversions API ficam no admin (Marketing e site).
# Estas só servem de reserva quando o admin está vazio.                  opcional
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
META_CAPI_TOKEN=
